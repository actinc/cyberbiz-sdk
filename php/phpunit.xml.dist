<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../vendor/autoload.php"
         cacheDirectory="../.phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="cyberbiz">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <!-- tests/Live/LiveTest.php calls the real API (CBSDK-42). Only the
         main pipeline runs it, by passing the group option for "live";
         see the live stage of bitbucket-pipelines.yml. -->
    <groups>
        <exclude>
            <group>live</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
