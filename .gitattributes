# Composer installs this package from GitHub's archive of the repository,
# which honours export-ignore: only the PHP SDK (php/src), composer.json,
# README.md and LICENSE belong in it.
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/.githooks export-ignore
/.publicignore export-ignore
/bitbucket-pipelines.yml export-ignore
/CLAUDE.md export-ignore
/CONTEXT.md export-ignore
/CONTRIBUTING.md export-ignore
/docs export-ignore
/go export-ignore
/java export-ignore
/scripts export-ignore
/testdata export-ignore
/php/tests export-ignore
/php/phpunit.xml.dist export-ignore
/php/phpstan.neon export-ignore
/php/.php-cs-fixer.dist.php export-ignore
/php/VERSION export-ignore
