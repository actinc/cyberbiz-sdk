{
    "name": "actinc/cyberbiz-sdk",
    "description": "PHP client for the CYBERBIZ e-commerce platform API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cyberbiz",
        "sdk",
        "api",
        "ecommerce",
        "webhook"
    ],
    "homepage": "https://github.com/actinc/cyberbiz-sdk",
    "support": {
        "source": "https://github.com/actinc/cyberbiz-sdk"
    },
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.4",
        "symfony/http-client": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Actinc\\Cyberbiz\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Actinc\\Cyberbiz\\Tests\\": "php/tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit -c php/phpunit.xml.dist",
        "stan": "phpstan analyse -c php/phpstan.neon --no-progress",
        "cs": "php-cs-fixer fix --config=php/.php-cs-fixer.dist.php --dry-run --diff",
        "cs-fix": "php-cs-fixer fix --config=php/.php-cs-fixer.dist.php",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    }
}
